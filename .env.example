VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional richer read-only player tracking source.
# When set, refreshes merge WOS Control player data with Century's player lookup.
WOS_CONTROL_API_KEY=
WOS_CONTROL_BASE_URL=https://woscontrol.com/api/v1

# Optional provider mode: merged, century, or woscontrol.
WOS_PLAYER_API_MODE=merged

# Optional overrides for the Century gift-code player lookup.
WOS_CENTURY_PLAYER_URL=https://wos-giftcode-api.centurygame.com/api/player
WOS_CENTURY_ORIGIN=https://wos-giftcode.centurygame.com
